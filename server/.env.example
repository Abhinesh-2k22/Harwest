# ============================================================
#  HarWest Server Environment Configuration
#  Copy this file to ".env" in the server directory.
# ============================================================

# --- Server Port & Environment ---
PORT=5000
NODE_ENV=development

# --- Client Origin (Allowed CORS Origin) ---
# In local development: http://localhost:5173
# In production on Vercel: https://your-site.vercel.app (or custom domain)
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas Connection URI ---
# 1. Log in to https://cloud.mongodb.com
# 2. In Network Access, add IP Address 0.0.0.0/0 (allow from anywhere)
# 3. In Database Access, create a database user (e.g. harwest_admin)
# 4. Click "Connect" -> "Drivers" (Node.js) -> copy connection string:
# Example: mongodb+srv://harwest_admin:<password>@cluster0.abcde.mongodb.net/harwest?retryWrites=true&w=majority
# (Remember to replace <password> with your real password, without < >)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/harwest?retryWrites=true&w=majority

# --- Cloudinary Media Storage (Images & Videos) ---
# Log in to https://cloudinary.com/console
# Option A: Paste the single CLOUDINARY_URL from your Cloudinary dashboard:
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
# Option B: Paste individual credentials:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- JWT Authentication Secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=super_secure_harwest_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# --- Admin Account Creation ---
# Used when running: npm run seed:admin
# Password must be at least 12 characters.
ADMIN_EMAIL=admin@harwest.example
ADMIN_PASSWORD=AdminPass123456!

# --- Upload Limits ---
MAX_UPLOAD_MB=50
